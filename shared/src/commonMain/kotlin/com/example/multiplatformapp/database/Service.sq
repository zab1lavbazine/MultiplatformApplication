CREATE TABLE monitoredService (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    url TEXT NOT NULL,
    timeoutMillis INTEGER NOT NULL,
    intervalMillis INTEGER NOT NULL
);

selectAll:
SELECT *
FROM monitoredService;

insertService:
INSERT INTO monitoredService(
    id,
    name,
    url,
    timeoutMillis,
    intervalMillis
)
VALUES (?, ?, ?, ?, ?);